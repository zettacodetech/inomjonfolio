generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("USER")
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]
  tokens        VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                String   @id @default("main")
  name              String
  headline          String
  bio               String
  headlineUz        String?
  headlineEn        String?
  headlineRu        String?
  bioUz             String?
  bioEn             String?
  bioRu             String?
  phoneNumber       String?
  contactEmail      String?
  location          String?
  heroImage         String
  cvUrl             String?
  telegramUrl       String?
  githubUrl         String?
  linkedinUrl       String?
  instagramUrl      String?
  careerStartDate DateTime?
  happyClientsCount Int      @default(20)
  experienceYearsOverride Int?
  updatedAt         DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  techStack   String
  visitUrl    String?
  githubUrl   String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        Tag[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  projects Project[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  group     String?
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocationSetting {
  id        String   @id @default("main")
  latitude  Float
  longitude Float
  iframeUrl String?
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteVisit {
  id         String   @id @default(cuid())
  visitorKey String
  path       String
  referrer   String?
  userAgent  String?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([visitorKey])
  @@index([createdAt])
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  coverUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  role        String
  company     String
  period      String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String?
  text      String
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
